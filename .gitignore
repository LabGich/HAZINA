# Python virtual environments
.venv/
venv/
env/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep
*.log

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE and editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.bak
*.swp

# Generated data
data/incoming/*
data/processed/*
data/archive/*

# Generated reports
reports/*

# Keep sample data directory structure
!data/incoming/.gitkeep
!data/processed/.gitkeep
!data/archive/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Uploaded fin trans
data/uploads/

# Hazina Pipeline generated files
hazina_pipeline/logs/*
!hazina_pipeline/logs/.gitkeep

hazina_pipeline/reports/*
hazina_pipeline/data/incoming/*
hazina_pipeline/data/processed/*
hazina_pipeline/data/archive/*
hazina_pipeline/data/uploads/

# Hazina Server generated files
hazina_server/logs/*
!hazina_server/logs/.gitkeep

hazina_server/reports/*
hazina_server/data/uploads/
# Python build artifacts
**/build/
**/*.egg-info/
